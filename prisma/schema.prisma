// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth models merged with app models
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     Boolean   @default(false)
  name              String?
  image             String?    @map("avatar")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  workspaces        WorkspaceUser[]
  transactions      Transaction[]
  categories        Category[]

  @@map("users")
}

model Account {
  id                String    @id @default(cuid())
  userId            String?
  workspaceId       String?
  name              String?
  type              String?
  provider          String?
  providerAccountId String?
  balance           Decimal?  @default(0) @db.Decimal(19, 2)
  isArchived        Boolean   @default(false)
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([provider, providerAccountId])
  @@unique([workspaceId, name])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// Workspace Models
model Workspace {
  id        String   @id @default(cuid())
  name      String
  type      WorkspaceType @default(PERSONAL)
  currency  String   @default("IDR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    WorkspaceUser[]
  transactions Transaction[]
  categories Category[]
  accounts Account[]

  @@map("workspaces")
}

enum WorkspaceType {
  PERSONAL
  UMKM
  PT
}

model WorkspaceUser {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("member")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_users")
}

// Category Model
model Category {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  type        CategoryType
  color       String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, userId, name])
  @@map("categories")
}

enum CategoryType {
  INCOME
  EXPENSE
}

// Transaction Model
model Transaction {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  accountId   String
  categoryId  String?
  description String
  amount      Decimal  @db.Decimal(19, 2)
  type        TransactionType
  date        DateTime
  notes       String?
  attachments String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([date])
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}
